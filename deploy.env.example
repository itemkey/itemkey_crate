APP_PORT=3000
APP_BASE_URL=https://itemkey.example.com

# Existing database connection. This is the safest production/default mode:
# the app container will not run schema.sql or migrations by itself.
DATABASE_URL=postgresql://user:password@database-host:5432/item_key
PG_CONNECTION_TIMEOUT_MS=5000
PG_QUERY_TIMEOUT_MS=0
PG_STATEMENT_TIMEOUT_MS=0
PG_LOCK_TIMEOUT_MS=0

# Only used when you intentionally run with docker-compose.local-db.yml.
POSTGRES_DB=item_key
POSTGRES_USER=itemkey
POSTGRES_PASSWORD=change-me-postgres-password

NEXT_PUBLIC_WORKSPACE_SLUG=main
WORKSPACE_SLUG=main

SESSION_TTL_DAYS=30
SESSION_HASH_PEPPER=change-me-random-session-pepper
AUTH_SESSION_MAX_PER_USER=5

USER_ID_CHANGE_COOLDOWN_DAYS=30
MIGRATION_CODE_TTL_MINUTES=20
MIGRATION_CODE_PEPPER=change-me-random-migration-pepper

AUTH_REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
AUTH_TOKEN_PEPPER=change-me-random-auth-token-pepper
AUTH_RATE_LIMIT_PEPPER=change-me-random-rate-limit-pepper

# Keep true for a public HTTPS domain.
# Set false only for private HTTP/LAN testing.
AUTH_COOKIE_SECURE=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=change-me-smtp-password
SMTP_FROM="Item Key <no-reply@example.com>"
SMTP_SECURE=false
